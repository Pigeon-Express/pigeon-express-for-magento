<?xml version="1.0"?>
<!-- Pigeon Express Shipping - Offices and APS tables -->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="pigeonexpress_office" resource="default" engine="innodb" comment="Pigeon Express Offices">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="api_id" unsigned="true" nullable="false" comment="API Office ID"/>
        <column xsi:type="varchar" name="environment" length="4" nullable="false" default="live" comment="Pigeon Express environment the row came from: live or test"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="Office Name"/>
        <column xsi:type="text" name="address" nullable="false" comment="Office Address"/>
        <column xsi:type="int" name="city_id" unsigned="true" nullable="true" comment="City ID from API"/>
        <column xsi:type="varchar" name="city" length="255" nullable="true" comment="City Name"/>
        <column xsi:type="varchar" name="country" length="2" nullable="true" default="BG" comment="Country Code"/>
        <column xsi:type="varchar" name="postcode" length="20" nullable="true" comment="Postcode"/>
        <column xsi:type="decimal" name="latitude" scale="8" precision="10" nullable="true" comment="Latitude"/>
        <column xsi:type="decimal" name="longitude" scale="8" precision="11" nullable="true" comment="Longitude"/>
        <column xsi:type="text" name="working_hours" nullable="true" comment="Working hours as JSON: list of {day, open, close}"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_OFFICE_API_ID_ENVIRONMENT">
            <column name="api_id"/>
            <column name="environment"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_OFFICE_NAME" indexType="btree">
            <column name="name"/>
        </index>
        <index referenceId="PIGEONEXPRESS_OFFICE_CITY" indexType="btree">
            <column name="city"/>
        </index>
        <index referenceId="PIGEONEXPRESS_OFFICE_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <table name="pigeonexpress_aps" resource="default" engine="innodb" comment="Pigeon Express APS (Lockers)">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="api_id" unsigned="true" nullable="false" comment="API APS ID"/>
        <column xsi:type="varchar" name="environment" length="4" nullable="false" default="live" comment="Pigeon Express environment the row came from: live or test"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" comment="APS Name"/>
        <column xsi:type="text" name="address" nullable="false" comment="APS Address"/>
        <column xsi:type="int" name="city_id" unsigned="true" nullable="true" comment="City ID from API"/>
        <column xsi:type="varchar" name="city" length="255" nullable="true" comment="City Name"/>
        <column xsi:type="varchar" name="country" length="2" nullable="true" default="BG" comment="Country Code"/>
        <column xsi:type="varchar" name="postcode" length="20" nullable="true" comment="Postcode"/>
        <column xsi:type="decimal" name="latitude" scale="8" precision="10" nullable="true" comment="Latitude"/>
        <column xsi:type="decimal" name="longitude" scale="8" precision="11" nullable="true" comment="Longitude"/>
        <column xsi:type="text" name="working_hours" nullable="true" comment="Working hours as JSON: list of {day, open, close}"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is Active"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_APS_API_ID_ENVIRONMENT">
            <column name="api_id"/>
            <column name="environment"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_APS_NAME" indexType="btree">
            <column name="name"/>
        </index>
        <index referenceId="PIGEONEXPRESS_APS_CITY" indexType="btree">
            <column name="city"/>
        </index>
        <index referenceId="PIGEONEXPRESS_APS_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <table name="pigeonexpress_city" resource="default" engine="innodb" comment="Pigeon Express Cities">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="api_id" unsigned="true" nullable="false" comment="City ID from API"/>
        <column xsi:type="varchar" name="environment" length="4" nullable="false" default="live" comment="Pigeon Express environment the row came from: live or test"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false" default="" comment="City Name (Bulgarian)"/>
        <column xsi:type="varchar" name="name_en" length="255" nullable="true" comment="City Name (English)"/>
        <column xsi:type="varchar" name="postal_code" length="20" nullable="true" comment="Postal Code"/>
        <column xsi:type="varchar" name="district" length="255" nullable="true" comment="District (Bulgarian)"/>
        <column xsi:type="varchar" name="district_en" length="255" nullable="true" comment="District (English)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_CITY_API_ID_ENVIRONMENT">
            <column name="api_id"/>
            <column name="environment"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_CITY_NAME" indexType="btree">
            <column name="name"/>
        </index>
        <index referenceId="PIGEONEXPRESS_CITY_POSTAL_CODE" indexType="btree">
            <column name="postal_code"/>
        </index>
    </table>

    <table name="pigeonexpress_quote_address" resource="default" engine="innodb" comment="Pigeon Express location per quote shipping address">
        <column xsi:type="int" name="address_id" unsigned="true" nullable="false" comment="Quote Address ID (quote_address.address_id)"/>
        <column xsi:type="varchar" name="pigeonexpress_delivery_type" length="32" nullable="true" comment="Delivery type: office, aps"/>
        <column xsi:type="varchar" name="pigeonexpress_location_id" length="50" nullable="true" comment="Office/APS location ID"/>
        <column xsi:type="varchar" name="pigeonexpress_location_name" length="255" nullable="true" comment="Location name"/>
        <column xsi:type="text" name="pigeonexpress_location_address" nullable="true" comment="Location address"/>
        <column xsi:type="text" name="pigeonexpress_instructions" nullable="true" comment="Delivery instructions"/>
        <column xsi:type="int" name="pigeonexpress_city_id" unsigned="true" nullable="true" comment="Pigeon Express city id chosen at checkout"/>
        <column xsi:type="int" name="pigeonexpress_street_id" unsigned="true" nullable="true" comment="Pigeon Express street id chosen at checkout"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="address_id"/>
        </constraint>
        <!-- No FK to quote_address: our plugin runs during quote save; the address row may not be committed yet -->
    </table>

    <table name="pigeonexpress_order_address" resource="default" engine="innodb" comment="Pigeon Express location per order shipping address">
        <column xsi:type="int" name="address_id" unsigned="true" nullable="false" comment="Order Address ID (sales_order_address.entity_id)"/>
        <column xsi:type="varchar" name="pigeonexpress_delivery_type" length="32" nullable="true" comment="Delivery type: office, aps"/>
        <column xsi:type="varchar" name="pigeonexpress_location_id" length="50" nullable="true" comment="Office/APS location ID"/>
        <column xsi:type="varchar" name="pigeonexpress_location_name" length="255" nullable="true" comment="Location name"/>
        <column xsi:type="text" name="pigeonexpress_location_address" nullable="true" comment="Location address"/>
        <column xsi:type="text" name="pigeonexpress_instructions" nullable="true" comment="Delivery instructions"/>
        <column xsi:type="decimal" name="pigeonexpress_delivery_price" precision="12" scale="4" nullable="true" comment="Delivery price at order place"/>
        <column xsi:type="smallint" name="pigeonexpress_free_shipping" unsigned="true" nullable="false" default="0" comment="Delivery was given away by a threshold or a cart rule"/>
        <column xsi:type="int" name="pigeonexpress_city_id" unsigned="true" nullable="true" comment="Pigeon Express city id chosen at checkout"/>
        <column xsi:type="int" name="pigeonexpress_street_id" unsigned="true" nullable="true" comment="Pigeon Express street id chosen at checkout"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="address_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_ORDER_ADDRESS_ADDRESS_ID_SALES_ORDER_ADDRESS_ENTITY_ID"
                   table="pigeonexpress_order_address" column="address_id"
                   referenceTable="sales_order_address" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="sales_order" resource="default">
        <column xsi:type="decimal" name="pigeonexpress_cod_fee" precision="12" scale="4" nullable="true"
                comment="Pigeon Express COD Fee as returned by the API for this order"/>
    </table>

    <table name="pigeonexpress_additional_service" resource="default" engine="innodb"
           comment="Pigeon Express additional services catalogue, synced from GET /additional-services">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="code" length="100" nullable="false"
                comment="Service code, used as key in the service_codes payload"/>
        <column xsi:type="varchar" name="name" length="255" nullable="true" comment="Service name"/>
        <column xsi:type="text" name="description" nullable="true" comment="Service description"/>
        <column xsi:type="varchar" name="input_type" length="20" nullable="true"
                comment="checkbox, text or select"/>
        <column xsi:type="varchar" name="option_group" length="100" nullable="true"
                comment="Mutually exclusive group; only one service per group may be selected"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1"
                comment="Present in the last successful catalogue sync"/>
        <column xsi:type="decimal" name="last_fee_amount" precision="12" scale="4" nullable="true"
                comment="Last fee the API charged for this service"/>
        <column xsi:type="decimal" name="last_fee_basis" precision="12" scale="4" nullable="true"
                comment="Value the last fee was calculated on, for proportional services"/>
        <column xsi:type="timestamp" name="fee_synced_at" nullable="true"
                comment="When last_fee_amount was last resolved from the API"/>
        <column xsi:type="timestamp" name="synced_at" nullable="false" default="CURRENT_TIMESTAMP"
                on_update="true" comment="Last catalogue sync"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_ADDITIONAL_SERVICE_CODE">
            <column name="code"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_ADDITIONAL_SERVICE_IS_ACTIVE" indexType="btree">
            <column name="is_active"/>
        </index>
    </table>

    <table name="pigeonexpress_shipment" resource="default" engine="innodb" comment="Pigeon Express Shipments">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID (sales_order.entity_id)"/>
        <column xsi:type="varchar" name="reference_number" length="100" nullable="true" comment="PE Reference Number (e.g. PGN-2026-00012345)"/>
        <column xsi:type="varchar" name="tracking_number" length="100" nullable="true" comment="Tracking Number"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="sent" comment="Shipment Status"/>
        <column xsi:type="decimal" name="delivery_price" precision="12" scale="4" nullable="true" comment="Delivery Price"/>
        <column xsi:type="text" name="payload" nullable="true" comment="JSON of request sent to API"/>
        <column xsi:type="text" name="response" nullable="true" comment="JSON of API response"/>
        <column xsi:type="text" name="form_fields" nullable="true" comment="JSON of the admin shipment form as sent, restored after a cancel"/>
        <column xsi:type="varchar" name="status_code" length="64" nullable="true" comment="Carrier status code, as last read"/>
        <column xsi:type="varchar" name="status_name" length="255" nullable="true" comment="Carrier name for that status"/>
        <column xsi:type="datetime" name="status_at" nullable="true" comment="When the carrier recorded the status (UTC)"/>
        <column xsi:type="datetime" name="status_checked_at" nullable="true" comment="Last successful status read (UTC)"/>
        <column xsi:type="mediumtext" name="details_json" nullable="true" comment="Last GET /shipments/{ref} answer, trimmed, with fetched_at"/>
        <column xsi:type="int" name="magento_shipment_id" unsigned="true" nullable="true" comment="Native Magento shipment (sales_shipment.entity_id)"/>
        <column xsi:type="timestamp" name="sent_at" on_update="false" nullable="true" default="CURRENT_TIMESTAMP" comment="Sent At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_SHIPMENT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                   table="pigeonexpress_shipment" column="order_id"
                   referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="PIGEONEXPRESS_SHIPMENT_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="PIGEONEXPRESS_SHIPMENT_REFERENCE_NUMBER" indexType="btree">
            <column name="reference_number"/>
        </index>
        <index referenceId="PIGEONEXPRESS_SHIPMENT_STATUS_STATUS_CODE" indexType="btree">
            <column name="status"/>
            <column name="status_code"/>
        </index>
    </table>

    <table name="pigeonexpress_auto_create" resource="default" engine="innodb"
           comment="Pigeon Express orders waiting for an automatic shipment">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID (sales_order.entity_id)"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="pending"
                comment="pending, running, done, skipped, failed or unknown"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Attempts made"/>
        <column xsi:type="timestamp" name="run_after" nullable="false" default="CURRENT_TIMESTAMP" on_update="false"
                comment="Not before this time"/>
        <column xsi:type="text" name="message" nullable="true" comment="Last result"/>
        <column xsi:type="timestamp" name="queued_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Queued At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_AUTO_CREATE_ORDER_ID_SALES_ORDER_ENTITY_ID"
                   table="pigeonexpress_auto_create" column="order_id"
                   referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="PIGEONEXPRESS_AUTO_CREATE_STATUS_RUN_AFTER" indexType="btree">
            <column name="status"/>
            <column name="run_after"/>
        </index>
    </table>
    <!-- The return shipment of an order (is_reverse): a table of its own, not a
         row in pigeonexpress_shipment, so nothing that reads the order's own
         waybill (grid, status sync, labels, native shipment) can pick it up.
         One live row per order (status created); cancelled rows are kept. -->
    <table name="pigeonexpress_return_shipment" resource="default" engine="innodb" comment="Pigeon Express return shipments">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID (sales_order.entity_id)"/>
        <column xsi:type="varchar" name="environment" length="4" nullable="false" default="live" comment="live or test"/>
        <column xsi:type="varchar" name="reference_number" length="100" nullable="false" comment="Waybill number"/>
        <column xsi:type="varchar" name="tracking_number" length="100" nullable="true" comment="Tracking number"/>
        <column xsi:type="varchar" name="status" length="32" nullable="false" default="created" comment="created or cancelled"/>
        <column xsi:type="varchar" name="status_code" length="64" nullable="true" comment="Carrier status code, as last read"/>
        <column xsi:type="varchar" name="status_name" length="255" nullable="true" comment="Carrier name for that status"/>
        <column xsi:type="datetime" name="status_checked_at" nullable="true" comment="Last status read (UTC)"/>
        <column xsi:type="mediumtext" name="details_json" nullable="true" comment="Last GET /shipments/{ref} answer, trimmed"/>
        <column xsi:type="text" name="payload" nullable="true" comment="JSON of the body sent"/>
        <column xsi:type="text" name="sent_json" nullable="true" comment="JSON of what was sent, as the panel shows it"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Admin who created it"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_RETURN_SHIPMENT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                   table="pigeonexpress_return_shipment" column="order_id"
                   referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="PIGEONEXPRESS_RETURN_SHIPMENT_ORDER_ID_STATUS" indexType="btree">
            <column name="order_id"/>
            <column name="status"/>
        </index>
        <index referenceId="PIGEONEXPRESS_RETURN_SHIPMENT_REFERENCE_NUMBER" indexType="btree">
            <column name="reference_number"/>
        </index>
    </table>

    <!-- Courier requests made from this shop. The API has no list endpoint,
         so the shop keeps its own. -->
    <table name="pigeonexpress_courier_request" resource="default" engine="innodb" comment="Pigeon Express courier requests">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="request_number" length="64" nullable="false" comment="Request number, e.g. CR-458106744669"/>
        <column xsi:type="varchar" name="environment" length="4" nullable="false" default="live" comment="live or test"/>
        <column xsi:type="varchar" name="status_code" length="64" nullable="true" comment="Carrier status code"/>
        <column xsi:type="varchar" name="status_name" length="255" nullable="true" comment="Carrier name for that status"/>
        <column xsi:type="date" name="pickup_date" nullable="true" comment="Requested pickup date"/>
        <column xsi:type="varchar" name="time_type" length="16" nullable="false" default="interval" comment="interval or specific_time"/>
        <column xsi:type="varchar" name="time_from" length="5" nullable="true" comment="HH:MM"/>
        <column xsi:type="varchar" name="time_to" length="5" nullable="true" comment="HH:MM"/>
        <column xsi:type="text" name="address" nullable="true" comment="Pickup address as one line"/>
        <column xsi:type="varchar" name="request_type" length="16" nullable="true" comment="single or groupage"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Admin who made it"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="datetime" name="checked_at" nullable="true" comment="Last status read (UTC)"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_COURIER_REQUEST_REQUEST_NUMBER_ENVIRONMENT">
            <column name="request_number"/>
            <column name="environment"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_COURIER_REQUEST_ENVIRONMENT_CREATED_AT" indexType="btree">
            <column name="environment"/>
            <column name="created_at"/>
        </index>
    </table>

    <table name="pigeonexpress_courier_request_shipment" resource="default" engine="innodb" comment="Shipments in a Pigeon Express courier request">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="request_id" unsigned="true" nullable="false" comment="pigeonexpress_courier_request.entity_id"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Order ID (sales_order.entity_id)"/>
        <column xsi:type="varchar" name="reference_number" length="100" nullable="false" comment="Waybill number"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_COURIER_REQUEST_SHIPMENT_REQUEST_ID_PIGEONEXPRESS_COURIER_REQUEST_ENTITY_ID"
                   table="pigeonexpress_courier_request_shipment" column="request_id"
                   referenceTable="pigeonexpress_courier_request" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="PIGEONEXPRESS_COURIER_REQUEST_SHIPMENT_ORDER_ID_SALES_ORDER_ENTITY_ID"
                   table="pigeonexpress_courier_request_shipment" column="order_id"
                   referenceTable="sales_order" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="PIGEONEXPRESS_COURIER_REQUEST_SHIPMENT_REQUEST_ID_REFERENCE_NUMBER">
            <column name="request_id"/>
            <column name="reference_number"/>
        </constraint>
        <index referenceId="PIGEONEXPRESS_COURIER_REQUEST_SHIPMENT_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
        <index referenceId="PIGEONEXPRESS_COURIER_REQUEST_SHIPMENT_REFERENCE_NUMBER" indexType="btree">
            <column name="reference_number"/>
        </index>
    </table>
</schema>
