<?xml version="1.0"?>
<!-- Pigeon Express Shipping - DI -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Custom log file: var/log/pigeonexpress.log -->
    <type name="PigeonExpress\Shipping\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">PigeonExpress</argument>
            <argument name="handlers" xsi:type="array">
                <item name="pigeonexpress" xsi:type="object">PigeonExpress\Shipping\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Api\LocationsClient">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Api\RateClient">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Api\ShipmentClient">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\ShipmentSender">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
            <!-- Proxy: WhoPaysFacts itself asks the sender whether an order is COD. -->
            <argument name="whoPaysFacts" xsi:type="object">PigeonExpress\Shipping\Model\Shipment\WhoPaysFacts\Proxy</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Api\AddressResolver">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Rate\RateCollector">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
            <!-- Optional in the constructor, so Magento passes null unless told to. -->
            <argument name="checkoutSession" xsi:type="object">Magento\Checkout\Model\Session\Proxy</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Cron\SyncLocations">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Shipment\AddressForm">
        <arguments>
            <argument name="locationPersistor" xsi:type="object">PigeonExpress\Shipping\Model\OrderAddressLocationPersistor</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Cron\AutoCreateShipments">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Observer\Sales\QueueAutoCreate">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
            <argument name="sender" xsi:type="object">PigeonExpress\Shipping\Api\ShipmentSenderInterface\Proxy</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Account\SavedAddresses">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\LocationSync">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Plugin\Shipping\ShippingLogPlugin">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Carrier\PigeonExpress">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Controller\Adminhtml\Order\Send">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <preference for="PigeonExpress\Shipping\Api\ConfigInterface"
                type="PigeonExpress\Shipping\Model\Config\ConfigProvider"/>
    <preference for="PigeonExpress\Shipping\Api\LocationsClientInterface"
                type="PigeonExpress\Shipping\Model\Api\LocationsClient"/>
    <preference for="PigeonExpress\Shipping\Api\RateClientInterface"
                type="PigeonExpress\Shipping\Model\Api\RateClient"/>
    <preference for="PigeonExpress\Shipping\Api\ShipmentClientInterface"
                type="PigeonExpress\Shipping\Model\Api\ShipmentClient"/>
    <preference for="PigeonExpress\Shipping\Api\ShipmentSenderInterface"
                type="PigeonExpress\Shipping\Model\ShipmentSender"/>
    <preference for="PigeonExpress\Shipping\Api\LocationSyncInterface"
                type="PigeonExpress\Shipping\Model\LocationSync"/>
    <preference for="PigeonExpress\Shipping\Api\LocationSearchInterface"
                type="PigeonExpress\Shipping\Model\LocationSearch"/>
    <preference for="PigeonExpress\Shipping\Api\AdditionalServicesClientInterface"
                type="PigeonExpress\Shipping\Model\Api\AdditionalServicesClient"/>
    <preference for="PigeonExpress\Shipping\Api\FreeShippingInterface"
                type="PigeonExpress\Shipping\Model\Rate\FreeShipping"/>
<type name="Magento\Checkout\Model\ShippingInformationManagement">
        <plugin name="pigeonexpress_validate_shipping" sortOrder="5"
                type="PigeonExpress\Shipping\Plugin\Checkout\ShippingInformationManagementValidationPlugin"/>
        <plugin name="pigeonexpress_save_address_extension" sortOrder="20"
                type="PigeonExpress\Shipping\Plugin\Checkout\ShippingInformationManagementPlugin"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Address\ToOrderAddress">
        <plugin name="pigeonexpress_quote_to_order_address"
                type="PigeonExpress\Shipping\Plugin\Quote\AddressToOrderAddressPlugin"/>
    </type>
    <type name="Magento\Quote\Model\QuoteManagement">
        <plugin name="pigeonexpress_validate_place_order" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Quote\QuoteManagementPlugin"/>
    </type>
    <type name="Magento\Checkout\Block\Checkout\LayoutProcessor">
        <plugin name="pigeonexpress_checkout_layout"
                type="PigeonExpress\Shipping\Plugin\Checkout\LayoutProcessorPlugin"/>
    </type>
    <type name="Magento\Shipping\Model\Shipping">
        <plugin name="pigeonexpress_shipping_log"
                type="PigeonExpress\Shipping\Plugin\Shipping\ShippingLogPlugin"/>
    </type>
    <!-- Persist Pigeon Express location on quote address (so it survives into place-order request) -->
    <type name="Magento\Quote\Model\Quote">
        <plugin name="pigeonexpress_quote_get_shipping_address" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Quote\QuoteShippingAddressPlugin"/>
    </type>
    <type name="Magento\Quote\Model\Quote\Address">
        <plugin name="pigeonexpress_quote_address_save" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Quote\QuoteAddressSavePlugin"/>
        <!-- Magento re-sorts every rate by price, so the order the carrier
             quotes in never survives. This puts our three back in the order the
             merchant configured, and leaves every other carrier alone. -->
        <plugin name="pigeonexpress_shipping_rate_sort" sortOrder="20"
                type="PigeonExpress\Shipping\Plugin\Quote\ShippingRateSortPlugin"/>
    </type>
    <type name="Magento\Quote\Model\ResourceModel\Quote\Address">
        <plugin name="pigeonexpress_quote_address_load" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Quote\QuoteAddressLoadPlugin"/>
    </type>
    <!-- Persist Pigeon Express location on order address (for admin, emails, etc.) -->
    <type name="Magento\Sales\Model\Order\Address">
        <plugin name="pigeonexpress_order_address_save" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Sales\OrderAddressSavePlugin"/>
    </type>
    <type name="Magento\Sales\Model\ResourceModel\Order\Address">
        <plugin name="pigeonexpress_order_address_load" sortOrder="10"
                type="PigeonExpress\Shipping\Plugin\Sales\OrderAddressLoadPlugin"/>
    </type>
    <!-- CompositeConfigProvider is registered in etc/frontend/di.xml, not here:
         an area definition beats a global one for that argument. -->
    <type name="Magento\Quote\Model\Quote\Address\ToOrder">
        <plugin name="pigeonexpress_cod_fee_to_order"
                type="PigeonExpress\Shipping\Plugin\Quote\ToOrderPlugin"/>
    </type>
    <!-- Native Magento shipment, tracking and completing on delivery: log to pigeonexpress.log. -->
    <type name="PigeonExpress\Shipping\Model\Magento\NativeShipment">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Magento\CompleteOnDelivery">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Magento\OrderComment">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Observer\Shipment\CreateMagentoShipment">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Observer\Shipment\RemoveMagentoTrack">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Observer\Shipment\CompleteOrderOnDelivery">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <!-- Magento DI leaves an optional "= null" constructor argument null, so
         ShipmentCanceller never had an event manager and the
         pigeonexpress_shipment_cancelled event was never dispatched. -->
    <type name="PigeonExpress\Shipping\Model\ShipmentCanceller">
        <arguments>
            <argument name="eventManager" xsi:type="object">Magento\Framework\Event\ManagerInterface</argument>
            <argument name="orderRepository" xsi:type="object">Magento\Sales\Api\OrderRepositoryInterface</argument>
            <!-- The cancel lock, and the details read after a 422 (a return or a redirect). -->
            <argument name="lock" xsi:type="object">PigeonExpress\Shipping\Model\Shipment\OrderLock</argument>
            <argument name="details" xsi:type="object">PigeonExpress\Shipping\Model\Status\ShipmentDetailsStore\Proxy</argument>
        </arguments>
    </type>
    <!-- A redirected shipment moves the order to the new one before its status
         is recorded (Model\Shipment\RedirectFollower). Proxy: needed only then. -->
    <type name="PigeonExpress\Shipping\Model\Status\StatusRefresher">
        <arguments>
            <argument name="follower" xsi:type="object">PigeonExpress\Shipping\Model\Shipment\RedirectFollower\Proxy</argument>
        </arguments>
    </type>
    <!-- Sales > Pigeon Express courier requests listing. -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="pigeonexpress_courier_request_listing_data_source" xsi:type="string">PigeonExpress\Shipping\Model\ResourceModel\CourierRequest\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Courier\CourierRequestSubmitter">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\Courier\CourierRequestService">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
    <type name="PigeonExpress\Shipping\Model\ReturnShipment\ReturnShipmentService">
        <arguments>
            <argument name="logger" xsi:type="object">PigeonExpress\Shipping\Logger\Logger</argument>
        </arguments>
    </type>
</config>
