{
    "name": "pigeonexpress/module-shipping",
    "description": "Pigeon Express courier shipping integration for Magento 2",
    "version": "1.2.0",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0",
        "magento/framework": "*",
        "magento/module-shipping": "*",
        "magento/module-quote": "*",
        "magento/module-checkout": "*",
        "magento/module-catalog": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*"
    },
    "autoload": {
        "psr-4": {
            "PigeonExpress\\Shipping\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "pigeonexpress/php-sdk": "The Pigeon Express API client. A copy is bundled in lib/, so this is only needed if you prefer to manage it with Composer."
    }
}
