/**
 * A help bubble beside a label.
 */
$peHelp = function (string $text) use ($escaper) {
    if ($text === '') {
        return '';
    }

    return '<span class="admin__field-tooltip">'
        . '<a class="admin__field-tooltip-action action-help"><span>'
        . $escaper->escapeHtml(__('What is this?')) . '</span></a>'
        . '<span class="admin__field-tooltip-content">' . $escaper->escapeHtml($text) . '</span>'
        . '</span>';
};

/**
 * One field of the form, laid out with its label above the control so two can
 * sit side by side.
 *
 * A field that failed a check is outlined and carries the reason underneath:
 * boxed and red when it stops the shipment, plain amber when it only risks a
 * misdelivery. Required is Magento's own asterisk, which is why the label stays
 * a direct child of the field.
 *
 * @param string $name    Form field name, also the id suffix
 * @param string $label   What the admin reads
 * @param int    $span    Width in twelfths of the form
 * @param array  $options required, tooltip, textarea, group, attributes
 */
$peField = function (string $name, string $label, int $span = 6, array $options = []) use ($block, $escaper, $peHelp) {
    $required = !empty($options['required']);
    $blocking = $block->isFieldInvalid($name);
    $message = $block->getFieldMessage($name);
    $id = 'pe_' . $name;

    $state = $blocking ? ' _error' : ($block->isFieldQuestionable($name) ? ' _warn' : '');
    $group = isset($options['group'])
        ? ' data-pe-group="' . $escaper->escapeHtmlAttr($options['group']) . '"'
        : '';

    $attributes = '';
    foreach (($options['attributes'] ?? []) as $key => $value) {
        $attributes .= ' ' . $escaper->escapeHtmlAttr($key) . '="' . $escaper->escapeHtmlAttr($value) . '"';
    }

    $control = !empty($options['textarea'])
        ? '<textarea class="admin__control-textarea" rows="2" id="' . $escaper->escapeHtmlAttr($id) . '"'
            . ' name="pe[' . $escaper->escapeHtmlAttr($name) . ']"' . $attributes . '>'
            . $escaper->escapeHtml($block->getFieldValue($name)) . '</textarea>'
        : '<input type="text" class="admin__control-text" id="' . $escaper->escapeHtmlAttr($id) . '"'
            . ' name="pe[' . $escaper->escapeHtmlAttr($name) . ']"'
            . ' value="' . $escaper->escapeHtmlAttr($block->getFieldValue($name)) . '"' . $attributes . '/>';

    if ($message === '') {
        $note = '';
    } elseif ($blocking) {
        $note = '<div class="admin__field-error pe-message">' . $escaper->escapeHtml($message) . '</div>';
    } else {
        $note = '<div class="admin__field-note pe-message _warn">' . $escaper->escapeHtml($message) . '</div>';
    }

    return '<div class="admin__field pe-span-' . (int) $span . ($required ? ' _required' : '') . $state . '"'
        . $group . '>'
        . '<span class="pe-label-row">'
        . '<label class="admin__field-label" for="' . $escaper->escapeHtmlAttr($id) . '">'
        . '<span>' . $escaper->escapeHtml($label) . '</span></label>'
        . $peHelp((string) ($options['tooltip'] ?? ''))
        . '</span>'
        . '<div class="admin__field-control">' . $control . $note . '</div>'
        . '</div>';
};

/**
 * One of the small boxes in the building row.
 */
$peSubField = function (string $name, string $label) use ($block, $escaper) {
    $id = 'pe_' . $name;

    return '<span class="pe-subfield">'
        . '<label for="' . $escaper->escapeHtmlAttr($id) . '">' . $escaper->escapeHtml($label) . '</label>'
        . '<input type="text" class="admin__control-text" id="' . $escaper->escapeHtmlAttr($id) . '"'
        . ' name="pe[' . $escaper->escapeHtmlAttr($name) . ']"'
        . ' value="' . $escaper->escapeHtmlAttr($block->getFieldValue($name)) . '"/>'
        . '</span>';
};
