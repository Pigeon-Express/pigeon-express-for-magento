$peDescriptionPlaceholder = $block->getPackageDescriptionPlaceholder();

/**
 * One package row. The index is a number for the rows already there and the
 * placeholder __INDEX__ in the template the Add button copies.
 */
$pePackageRow = function (string $index, array $row) use ($escaper, $peFragileColumn, $peFragileLocked, $peDescriptionPlaceholder, $block) {
    $name = function (string $key) use ($index, $escaper) {
        return $escaper->escapeHtmlAttr('pe[packages][' . $index . '][' . $key . ']');
    };
    $box = function (string $key, string $mode, string $label) use ($row, $name, $escaper) {
        return '<input type="text" class="admin__control-text pe-package-' . $key . '"'
            . ' name="' . $name($key) . '" value="' . $escaper->escapeHtmlAttr((string) $row[$key]) . '"'
            . ' inputmode="' . $mode . '" aria-label="' . $escaper->escapeHtmlAttr($label) . '"'
            . ' data-role="pe-package-input"/>';
    };

    $html = '<tr data-role="pe-package-row">'
        . '<td class="pe-col-weight">' . $box('weight', 'decimal', (string) __('Weight (kg)')) . '</td>'
        . '<td class="pe-col-size">' . $box('length', 'numeric', (string) __('Length (cm)')) . '</td>'
        . '<td class="pe-col-size">' . $box('width', 'numeric', (string) __('Width (cm)')) . '</td>'
        . '<td class="pe-col-size">' . $box('height', 'numeric', (string) __('Height (cm)')) . '</td>'
        . '<td class="pe-col-description"><input type="text" class="admin__control-text pe-package-description"'
        . ' name="' . $name('description') . '" value="' . $escaper->escapeHtmlAttr((string) $row['description']) . '"'
        . ' maxlength="' . (int) $block->getPackageDescriptionMaxLength() . '"'
        . ' placeholder="' . $escaper->escapeHtmlAttr($peDescriptionPlaceholder) . '"'
        . ' aria-label="' . $escaper->escapeHtmlAttr(__('Description')) . '"/></td>';

    if ($peFragileColumn) {
        // Locked on "always": shown so the admin knows, but a disabled box is
        // not submitted, and the server marks every package fragile anyway.
        $html .= '<td class="pe-col-fragile"><input type="checkbox" class="pe-package-fragile"'
            . ' name="' . $name('fragile') . '" value="1"'
            . ' aria-label="' . $escaper->escapeHtmlAttr(__('Fragile')) . '"'
            . (!empty($row['fragile']) ? ' checked="checked"' : '')
            . ($peFragileLocked ? ' disabled="disabled"' : '') . '/></td>';
    }

    $html .= '<td class="pe-col-remove"><button type="button" class="pe-package-remove"'
        . ' data-role="pe-package-remove" title="' . $escaper->escapeHtmlAttr(__('Remove package')) . '"'
        . ' aria-label="' . $escaper->escapeHtmlAttr(__('Remove package')) . '">'
        . '<span aria-hidden="true">&times;</span></button></td>'
        . '</tr>';

    return $html;
};
