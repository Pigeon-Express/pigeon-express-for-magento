        $idName = $name . '_id';
        $labelName = $name . '_label';
        $config = ['url' => $url, 'noResults' => (string) __('No matches found.')];
        if ($dependsOn !== '') {
            $config['dependsOn'] = $dependsOn;
        }

        return '<div class="admin__field pe-span-' . $span . ($required ? ' _required' : '') . '">'
            . '<span class="pe-label-row"><label class="admin__field-label" for="pe_rs_' . $escaper->escapeHtmlAttr($name) . '"><span>'
            . $escaper->escapeHtml($label) . '</span></label></span>'
