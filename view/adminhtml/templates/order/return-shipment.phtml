        $box = function (string $key, string $label) use ($index, $row, $escaper) {
            return '<td><input type="text" class="admin__control-text" inputmode="decimal"'
                . ' name="rs[packages][' . $escaper->escapeHtmlAttr($index) . '][' . $key . ']"'
                . ' value="' . $escaper->escapeHtmlAttr((string) ($row[$key] ?? '')) . '"'
                . ' aria-label="' . $escaper->escapeHtmlAttr($label) . '"/></td>';
        };

        return '<tr>' . $box('weight', (string) __('Weight (kg)')) . $box('length', (string) __('Length (cm)'))
            . $box('width', (string) __('Width (cm)')) . $box('height', (string) __('Height (cm)'))
            . '<td><button type="button" class="pe-package-remove" data-role="pe-rs-remove"'
            . ' title="' . $escaper->escapeHtmlAttr(__('Remove package')) . '"><span aria-hidden="true">&times;</span></button></td></tr>';
