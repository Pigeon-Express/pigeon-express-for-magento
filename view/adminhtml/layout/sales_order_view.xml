<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="PigeonExpress_Shipping::css/shipment-form.css"/>
    </head>
    <body>
        <referenceContainer name="order_additional_info">
            <block class="PigeonExpress\Shipping\Block\Delivery\Info"
                   name="pigeonexpress.delivery.info.admin"
                   template="PigeonExpress_Shipping::delivery/info.phtml"
                   before="-">
                <!-- Included from delivery/info.phtml with getChildHtml(). -->
                <block class="PigeonExpress\Shipping\Block\Adminhtml\Order\ReturnShipment"
                       name="pigeonexpress.return.shipment"/>
                <block class="PigeonExpress\Shipping\Block\Adminhtml\Order\CourierRequest"
                       name="pigeonexpress.courier.request"/>
                <!-- The "Quick changes" box, once Edit is over (Model\QuickActions). -->
                <block class="PigeonExpress\Shipping\Block\Adminhtml\Order\QuickActions"
                       name="pigeonexpress.quick.actions"/>
            </block>
        </referenceContainer>
    </body>
</page>
