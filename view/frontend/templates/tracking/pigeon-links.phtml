<?php
/**
 * @var \PigeonExpress\Shipping\Block\Tracking\PigeonLinks $block
 * @var \Magento\Framework\Escaper $escaper
 */
$links = $block->getLinks();
?>
<?php if ($links): ?>
    <div class="pigeonexpress-tracking-links">
        <?php foreach ($links as $number => $url): ?>
            <p>
                <?= $escaper->escapeHtml(__('Track your shipment')) ?>
                <?= $escaper->escapeHtml($number) ?>:
                <a href="<?= $escaper->escapeUrl($url) ?>" target="_blank" rel="noopener">
                    <?= $escaper->escapeHtml(__('Pigeon Express tracking page')) ?>
                </a>
            </p>
        <?php endforeach; ?>
    </div>
<?php endif; ?>
