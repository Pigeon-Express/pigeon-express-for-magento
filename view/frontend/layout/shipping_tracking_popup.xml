<?xml version="1.0"?>
<!-- Link to the Pigeon Express tracking page under Magento's tracking popup. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="PigeonExpress\Shipping\Block\Tracking\PigeonLinks"
                   name="pigeonexpress.tracking.links"
                   template="PigeonExpress_Shipping::tracking/pigeon-links.phtml"
                   after="shipping.tracking.popup"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
