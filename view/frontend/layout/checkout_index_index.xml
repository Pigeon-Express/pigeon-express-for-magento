<?xml version="1.0"?>
<!--
 * Pigeon Express: location autocomplete injected via LayoutProcessor plugin.
 * Office/APS: select from local DB only. Address: standard Magento address fields.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="PigeonExpress_Shipping::css/checkout/checkout-panel.css"/>
        <css src="PigeonExpress_Shipping::css/checkout/location-autocomplete.css"/>
        <css src="PigeonExpress_Shipping::css/checkout/address-fields.css"/>
        <css src="PigeonExpress_Shipping::css/checkout/carrier-logo.css"/>
    </head>
    <body>
        <!-- Renders nothing: it puts a class on the body early enough that the
             address fields the carrier replaces are never drawn at all. -->
        <referenceContainer name="before.body.end">
            <block class="PigeonExpress\Shipping\Block\Checkout\BodyClass"
                   name="pigeonexpress.checkout.body.class"/>
        </referenceContainer>
    </body>
</page>
